{
  "manifest_version": 3,
  "name": "BR Fantasy — League Connector",
  "version": "1.3.6",
  "description": "Connect private ESPN leagues to BR Fantasy and auto-relay live ESPN/Yahoo draft picks into Draft Room.",
  "permissions": ["cookies", "scripting"],
  "host_permissions": [
    "https://*.espn.com/*",
    "https://*.fantasysports.yahoo.com/*",
    "https://sports.yahoo.com/*",
    "https://www.brfantasyfootball.com/*",
    "https://brfantasyfootball.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Connect ESPN / Yahoo to BR Fantasy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.brfantasyfootball.com/*",
        "https://brfantasyfootball.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*",
        "https://fantasy.espn.com/*/football/draft*",
        "https://fantasy.espn.com/*draft*"
      ],
      "js": ["espn_draft_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*",
        "https://fantasy.espn.com/*/football/draft*",
        "https://fantasy.espn.com/*draft*"
      ],
      "js": ["espn_draft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/f1/*/draft*",
        "https://football.fantasysports.yahoo.com/f1/*/livedraft*",
        "https://football.fantasysports.yahoo.com/draftclient*",
        "https://*.fantasysports.yahoo.com/*/draft*",
        "https://sports.yahoo.com/fantasy/*/draft*"
      ],
      "js": ["yahoo_draft_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://football.fantasysports.yahoo.com/f1/*/draft*",
        "https://football.fantasysports.yahoo.com/f1/*/livedraft*",
        "https://football.fantasysports.yahoo.com/draftclient*",
        "https://*.fantasysports.yahoo.com/*/draft*",
        "https://sports.yahoo.com/fantasy/*/draft*"
      ],
      "js": ["yahoo_draft.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "espn-connector@brfantasyfootball.com", "strict_min_version": "121.0" }
  }
}
